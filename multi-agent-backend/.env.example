# ============================================================================
# Multi-agent backend — environment configuration
# Copy to .env and adjust. Everything here flows into the Pydantic Settings
# class in backend/config.py (the single source of truth).
# NOTE: inside docker-compose the service-internal hosts (postgres/redis/
# litellm) are overridden by the compose `environment:` block; the values
# below are what the backend uses when running OUTSIDE Docker.
# ============================================================================

# --- core ---
ENVIRONMENT=development
DEBUG=true
# Comma-separated list of accepted bearer tokens for /v1/* endpoints.
# Empty disables auth entirely (local dev). Open WebUI sends this as its OPENAI_API_KEY.
BACKEND_API_KEYS=sk-local-dev
PUBLIC_BASE_URL=http://localhost:8000

# --- PostgreSQL (compose interpolation + local dev fallback) ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent

# --- Redis (cache + pub/sub) ---
REDIS_URL=redis://localhost:6379/0

# --- LiteLLM proxy ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-local-litellm-master
LITELLM_MASTER_KEY=sk-local-litellm-master
DEFAULT_MODEL=agent-default
# Provider keys consumed by litellm_config.yaml:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- agent context (git-versioned) ---
CONTEXT_DIR=context

# --- DuckDB (embedded, in-process) ---
DUCKDB_PATH=data/analytics.duckdb
EXECUTE_ANALYTICS_SQL=true

# --- n8n human-approval webhooks (leave empty to disable the trigger) ---
N8N_WEBHOOK_URL=

# --- observability ---
LOG_LEVEL=INFO
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
