# =============================================================================
# Multi-agent backend — environment configuration
# Copy to .env and fill in your keys.
# Everything here flows into the Pydantic Settings class in backend/config.py.
# NOTE: inside docker-compose, service-internal hosts (postgres/redis/litellm)
# are overridden by the compose `environment:` block; the values below are used
# when running OUTSIDE Docker.
# =============================================================================

# --- Core ---
ENVIRONMENT=development
DEBUG=true
BACKEND_API_KEYS=sk-local-dev
PUBLIC_BASE_URL=http://localhost:8000

# --- PostgreSQL ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LiteLLM proxy ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-local-litellm-master
LITELLM_MASTER_KEY=sk-local-litellm-master

# Which model alias to use as default — must match a model_name in litellm_config.yaml
# Current options (set the key for whichever you pick):
#   openrouter-free    openrouter-nemotron-ultra  openrouter-minimax-m3
#   groq-llama         gemini-flash               cerebras-llama
#   sambanova-llama    deepseek-chat              anthropic-haiku
DEFAULT_MODEL=openrouter-free

# =============================================================================
# LLM PROVIDER API KEYS
# Set the keys you have. Leave others blank.
# Restart LiteLLM after changes:  docker compose restart litellm
# =============================================================================

# ── Aggregators / Multi-model (best for testing — one key, many models) ──────

# OpenRouter (200+ models, free :free variants available) → https://openrouter.ai/keys
OPENROUTER_API_KEY=

# AI/ML API → https://aimlapi.com
AIML_API_KEY=

# Novita AI → https://novita.ai
NOVITA_API_KEY=

# ── Free Tier / No Credit Card ────────────────────────────────────────────────

# Groq (14,400 req/day free forever) → https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (1,500 req/day free) → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Cerebras (free tier) → https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# SambaNova (free forever) → https://cloud.sambanova.ai
SAMBANOVA_API_KEY=

# Hugging Face (free inference) → https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Nvidia NIM (free credits on signup) → https://build.nvidia.com
NVIDIA_NIM_API_KEY=

# ── Major Western Providers ───────────────────────────────────────────────────

# Anthropic → https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI → https://platform.openai.com/api-keys
OPENAI_API_KEY=

# xAI / Grok → https://console.x.ai
XAI_API_KEY=

# Mistral AI → https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Perplexity AI → https://www.perplexity.ai/settings/api
PERPLEXITYAI_API_KEY=

# Cohere → https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Fireworks AI → https://fireworks.ai/account/api-keys
FIREWORKS_AI_API_KEY=

# Together AI → https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# DeepInfra → https://deepinfra.com/dash
DEEPINFRA_API_KEY=

# Hyperbolic → https://app.hyperbolic.xyz
HYPERBOLIC_API_KEY=

# Replicate → https://replicate.com/account/api-tokens
REPLICATE_API_KEY=

# Lambda AI → https://lambda.ai
LAMBDA_API_KEY=

# Google Vertex AI → service account credentials
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=us-central1

# ── Chinese / Asian Providers ─────────────────────────────────────────────────

# DeepSeek (5M free tokens on signup) → https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Moonshot AI / Kimi → https://platform.moonshot.ai
# For China endpoint set: MOONSHOT_API_BASE=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=

# Alibaba / Qwen via DashScope → https://dashscope.console.aliyun.com
# International base: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# Zhipu AI / GLM (Z.AI) → https://open.bigmodel.cn
ZAI_API_KEY=

# MiniMax → https://platform.minimax.io
MINIMAX_API_KEY=

# Volcengine / ByteDance (Doubao) → https://console.volcengine.com
VOLCENGINE_API_KEY=

# Baidu Qianfan (ERNIE) → https://console.bce.baidu.com/qianfan
QIANFAN_AK=
QIANFAN_SK=

# Tencent Hunyuan → https://console.cloud.tencent.com
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# ModelScope → https://modelscope.cn
MODELSCOPE_API_KEY=

# ── Cloud-Managed AI ──────────────────────────────────────────────────────────

# AWS Bedrock → IAM credentials with Bedrock model access
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# Azure OpenAI → https://portal.azure.com
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-02-01

# Azure AI (serverless endpoints / GitHub Models)
AZURE_AI_API_KEY=
AZURE_AI_API_BASE=

# IBM Watsonx → https://cloud.ibm.com
WATSONX_API_KEY=
WATSONX_URL=
WATSONX_PROJECT_ID=

# Databricks → https://docs.databricks.com/en/dev-tools/auth/pat.html
DATABRICKS_API_KEY=
DATABRICKS_API_BASE=

# =============================================================================
# Agent context & storage
# =============================================================================

CONTEXT_DIR=context
DUCKDB_PATH=data/analytics.duckdb
EXECUTE_ANALYTICS_SQL=true

# --- n8n human-approval webhooks (leave empty to disable) ---
N8N_WEBHOOK_URL=

# --- Observability ---
LOG_LEVEL=INFO
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
