# ============================================================================
# Multi-agent backend — environment configuration
# Copy to .env and adjust. Everything here flows into the Pydantic Settings
# class in backend/config.py (the single source of truth).
# NOTE: inside docker-compose the service-internal hosts (postgres/redis/
# litellm) are overridden by the compose `environment:` block; the values
# below are what the backend uses when running OUTSIDE Docker.
# ============================================================================

# --- core ---
ENVIRONMENT=development
DEBUG=true
# Comma-separated list of accepted bearer tokens for /v1/* endpoints.
# Empty disables auth entirely (local dev). Open WebUI sends this as its OPENAI_API_KEY.
BACKEND_API_KEYS=sk-local-dev
PUBLIC_BASE_URL=http://localhost:8000

# --- PostgreSQL (compose interpolation + local dev fallback) ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent

# --- Redis (cache + pub/sub) ---
REDIS_URL=redis://localhost:6379/0

# --- LiteLLM proxy ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-local-litellm-master
LITELLM_MASTER_KEY=sk-local-litellm-master
DEFAULT_MODEL=agent-default

# ── Provider keys — set whichever you have, leave others blank ──────────────
# Only keys that are set will be forwarded to LiteLLM.
# Edit litellm_config.yaml to activate/switch the corresponding model entries.
# Restart LiteLLM after changes: docker compose restart litellm

# ── TIER 1: Major Western Providers ─────────────────────────────────────────

# Anthropic  →  https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI  →  https://platform.openai.com/api-keys
OPENAI_API_KEY=

# xAI / Grok  →  https://console.x.ai
XAI_API_KEY=

# Google Gemini (AI Studio)  →  https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google Vertex AI  →  service account JSON path or ADC
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=us-central1

# Groq  →  https://console.groq.com/keys
GROQ_API_KEY=

# Mistral AI  →  https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Perplexity AI  →  https://www.perplexity.ai/settings/api
PERPLEXITYAI_API_KEY=

# Cohere  →  https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Cerebras  →  https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# SambaNova  →  https://cloud.sambanova.ai
SAMBANOVA_API_KEY=

# Fireworks AI  →  https://fireworks.ai/account/api-keys
FIREWORKS_AI_API_KEY=

# Together AI  →  https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# DeepInfra  →  https://deepinfra.com/dash
DEEPINFRA_API_KEY=

# Hyperbolic  →  https://app.hyperbolic.xyz
HYPERBOLIC_API_KEY=

# Replicate  →  https://replicate.com/account/api-tokens
REPLICATE_API_KEY=

# Hugging Face  →  https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Nvidia NIM  →  https://build.nvidia.com
NVIDIA_NIM_API_KEY=

# Lambda AI  →  https://lambda.ai
LAMBDA_API_KEY=

# ── TIER 2: Chinese / Asian Providers ───────────────────────────────────────

# DeepSeek  →  https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Moonshot AI / Kimi  →  https://platform.moonshot.ai
# For China endpoint set MOONSHOT_API_BASE=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=

# Alibaba / Qwen via DashScope  →  https://dashscope.console.aliyun.com
# For international: DASHSCOPE_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# Zhipu AI / GLM (Z.AI)  →  https://open.bigmodel.cn
ZAI_API_KEY=

# MiniMax  →  https://platform.minimax.io
MINIMAX_API_KEY=

# Volcengine / ByteDance (Doubao/Skylark)  →  https://console.volcengine.com
VOLCENGINE_API_KEY=

# Baidu Qianfan (ERNIE)  →  https://console.bce.baidu.com/qianfan
QIANFAN_AK=
QIANFAN_SK=

# Tencent Hunyuan  →  https://console.cloud.tencent.com
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# ModelScope  →  https://modelscope.cn
MODELSCOPE_API_KEY=

# ── TIER 3: Cloud-Managed AI ─────────────────────────────────────────────────

# AWS Bedrock  →  IAM credentials with Bedrock access
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# Azure OpenAI  →  https://portal.azure.com
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-02-01

# Azure AI (serverless endpoints / GitHub Models)
AZURE_AI_API_KEY=
AZURE_AI_API_BASE=

# IBM Watsonx  →  https://cloud.ibm.com/apidocs/watsonx-ai
WATSONX_API_KEY=
WATSONX_URL=
WATSONX_PROJECT_ID=

# Databricks  →  https://docs.databricks.com/en/dev-tools/auth/pat.html
DATABRICKS_API_KEY=
DATABRICKS_API_BASE=

# ── TIER 4: Aggregators / Multi-model Gateways ───────────────────────────────

# OpenRouter (200+ models, one key)  →  https://openrouter.ai/keys
OPENROUTER_API_KEY=

# AI/ML API  →  https://aimlapi.com
AIML_API_KEY=

# Novita AI  →  https://novita.ai
NOVITA_API_KEY=

# --- agent context (git-versioned) ---
CONTEXT_DIR=context

# --- DuckDB (embedded, in-process) ---
DUCKDB_PATH=data/analytics.duckdb
EXECUTE_ANALYTICS_SQL=true

# --- n8n human-approval webhooks (leave empty to disable the trigger) ---
N8N_WEBHOOK_URL=

# --- observability ---
LOG_LEVEL=INFO
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
